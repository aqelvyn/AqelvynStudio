# ============================================================
# AQELVYN Studio — environment configuration
# Copy to .env.local (Next.js) or set these in your host's env UI.
# ============================================================

# ---- Required for enforced, persistent unlocks (production) ----
# Upstash / Vercel KV REST endpoint. Create a free KV database and paste its
# REST URL + token here so unlocks persist on serverless hosts (Vercel, Netlify,
# Cloudflare). If left empty, the app falls back to a local JSON file (works on
# long-running hosts with a disk, e.g. Render / Railway / Fly.io).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Optional ----
# Cronos RPC used for on-chain payment verification.
CRONOS_RPC_URL=https://evm.cronos.org

# Treasury address that receives payments (defaults to the studio treasury).
# The treasury is never embedded in the client bundle or prompt text.
TREASURY=

# HMAC secret for unlock tokens (rotated per deploy; not required for the
# on-chain verification itself, which is the real enforcement).
VERIFY_SECRET=change-me-to-a-long-random-string

# WalletConnect project id (for the RainbowKit wallet modal). Injected wallets
# (MetaMask) work without it. Get one free at cloud.walletconnect.com.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Canonical public URL (used for SEO: sitemap, robots, canonical links, JSON-LD).
# Set this to your real domain when you deploy so search engines index correctly.
NEXT_PUBLIC_SITE_URL=https://aqelvyn.studio
